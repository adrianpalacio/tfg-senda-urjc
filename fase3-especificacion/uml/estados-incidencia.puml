@startuml estados-incidencia
' Diagrama de estados de la incidencia reportada y su ticket
' Derivado del parrafo rosado 2 + RF-15..RF-18 (actualizado 25/08/2026 tras Entrevista 1)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #6B7280
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #4B5563
skinparam ArrowFontSize 11
skinparam TitleFontName "Segoe UI Semibold"
skinparam TitleFontSize 17
skinparam TitleFontColor #111827
skinparam state {
  BackgroundColor #F7F8FA
  BorderColor #CB0017
  BorderThickness 1.4
  RoundCorner 14
  FontColor #111827
  FontStyle bold
  FontSize 13
  AttributeFontColor #4B5563
  AttributeFontSize 11
  StartColor #CB0017
  EndColor #111827
}

title Ciclo de vida de una incidencia y su ticket

[*] --> Reportada : usuario reporta\n(4 tipos, RF-15)

state "Reportada" as Reportada : registrada con\nubicación y fecha

state "Efecto en el algoritmo" as Efecto {
  [*] --> PendienteRevision : reporte subjetivo\n(zona solitaria/miedo)
  PendienteRevision --> Penalizando : el admin asigna un\ngrado de inseguridad [S-12]
  Penalizando --> Penalizando : el admin cambia\nel grado [S-12]
  Penalizando --> SinEfecto : el admin disuelve\nla penalización [S-12]
  SinEfecto --> [*]
}

state "Ticket de resolución" as TicketState {
  [*] --> Abierto
  Abierto : creado en el panel web,\ncon gravedad grave/media (RF-17)
  Abierto --> EnCurso : el admin deriva a\nmantenimiento URJC\no LumenSmart [S-10]
  EnCurso --> Resuelto : intervención completada
  Resuelto : se notifica a quien\nreportó (RF-18)
  Resuelto --> [*]
}

Reportada --> Efecto
Reportada --> TicketState
@enduml
