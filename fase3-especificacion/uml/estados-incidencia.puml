@startuml estados-incidencia
' Diagrama de estados de la incidencia reportada y su ticket
' Rehecho 12/09/2026 segun comentarios del tutor (pags 97-98 de la revision):
' plano (sin estados compuestos ni segundos puntos de inicio), sin titulo
' interno, sin marcadores [S-XX].
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #6B7280
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #4B5563
skinparam ArrowFontSize 11
skinparam state {
  BackgroundColor #F7F8FA
  BorderColor #CB0017
  BorderThickness 1.4
  RoundCorner 14
  FontColor #111827
  FontStyle bold
  FontSize 13
  AttributeFontColor #4B5563
  AttributeFontSize 11
  StartColor #CB0017
  EndColor #111827
}

state "Reportada" as Reportada : registrada con\nubicación y fecha
state "Abierta" as Abierta : ticket creado en el panel web\ncon gravedad grave/media
state "En curso" as EnCurso : derivada a mantenimiento\nURJC o a LumenSmart
state "Resuelta" as Resuelta : se notifica a\nquien reportó

[*] --> Reportada : usuario reporta\n(cuatro tipos)
Reportada --> Abierta : el panel genera\nel ticket
Abierta --> Abierta : el administrador asigna o\ncambia el grado de inseguridad
Abierta --> EnCurso : el administrador\nderiva la intervención
EnCurso --> Resuelta : intervención\ncompletada
Resuelta --> [*]
@enduml
