@startuml estados-voy-contigo
' Diagrama de estados del trayecto con modo "Voy contigo" activo
' Rehecho 12/09/2026 segun comentarios del tutor (pag 97 de la revision):
' sin titulo interno (duplica el pie de figura), sin marcadores [S-XX], sin notas.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #6B7280
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #4B5563
skinparam ArrowFontSize 11
skinparam state {
  BackgroundColor #F7F8FA
  BorderColor #CB0017
  BorderThickness 1.4
  RoundCorner 14
  FontColor #111827
  FontStyle bold
  FontSize 13
  AttributeFontColor #4B5563
  AttributeFontSize 11
  StartColor #CB0017
  EndColor #111827
}

state "Configurado" as Configurado : destinatario elegido:\ncontacto o voluntario
state "En curso\n(supervisado)" as EnCurso : ubicación compartida\nen tiempo real
state "Prealerta" as Prealerta : vibración + notificación
state "Alerta emitida" as Alerta : aviso con última ubicación\nal contacto o Seguridad;\nla compartición sigue activa
state "Finalizado" as Fin : cesa la compartición;\nhistorial 24 h si no hay incidencia

[*] --> Configurado : usuario activa el modo\nantes de iniciar
Configurado --> EnCurso : inicia el trayecto
EnCurso --> Prealerta : desvío del camino,\nparada por inactividad\no pérdida de cobertura
Prealerta --> EnCurso : confirma «estoy bien»\nen plazo (30 s por defecto)
Prealerta --> Alerta : sin confirmar en plazo
EnCurso --> EnCurso : solicita ruta nueva:\nse re-ancla sin alerta
EnCurso --> Alerta : botón SOS
Prealerta --> Alerta : botón SOS
Alerta --> Fin : incidencia atendida /\ntrayecto cerrado
EnCurso --> Fin : llega al destino
Fin --> [*]
@enduml
